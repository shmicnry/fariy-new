# Pass these environment variables when starting Fairy; .env is not auto-loaded.
FAIRY_TOKEN=
FAIRY_DATABASE_URL=sqlite:///var/fairy.db
FAIRY_STATE_DIR=var
# Used to initialize the profile on first start; later changes are managed in the UI.
FAIRY_OLLAMA_BASE_URL=http://127.0.0.1:11434
FAIRY_OLLAMA_MODEL=qwen3:4b
# Optional initial cloud profile. Enabling fallback still requires an explicit UI save.
FAIRY_CLOUD_BASE_URL=
FAIRY_CLOUD_MODEL=
# Optional env secret, bound to the exact FAIRY_CLOUD_BASE_URL; alternatively enter in UI.
FAIRY_CLOUD_API_KEY=
