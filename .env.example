# Pass these environment variables when starting Fairy; .env is not auto-loaded.
FAIRY_TOKEN=
FAIRY_DATABASE_URL=postgresql+psycopg://your_macos_user@127.0.0.1:5432/fairy
# For tests, point at an administrative test database. Tests create/drop isolated schemas.
FAIRY_TEST_POSTGRES_URL=postgresql+psycopg://your_macos_user@127.0.0.1:5432/postgres
FAIRY_STATE_DIR=var
# Keep disabled for loopback-only use. For a physical iPhone, expose through an
# HTTPS reverse proxy/Tailscale and list only its exact trusted hostname.
FAIRY_ALLOW_LAN=0
FAIRY_ALLOWED_HOSTS=
# Optional IANA timezone for daily autonomy budgets. Empty uses the Mac timezone.
FAIRY_DAY_TIMEZONE=
# Used to initialize the profile on first start; later changes are managed in the UI.
FAIRY_OLLAMA_BASE_URL=http://127.0.0.1:11434
FAIRY_OLLAMA_MODEL=qwen3:4b
# Optional local neural embeddings. Leave empty to disable and use local character vectors.
FAIRY_EMBEDDING_MODEL=bge-m3:latest
# Optional initial cloud profile. Enabling fallback still requires an explicit UI save.
FAIRY_CLOUD_BASE_URL=
FAIRY_CLOUD_MODEL=
# Optional env secret, bound to the exact FAIRY_CLOUD_BASE_URL; alternatively enter in UI.
FAIRY_CLOUD_API_KEY=
# Optional local speech. macOS TTS uses /usr/bin/say automatically.
# Set an existing whisper-cli binary and GGML model to enable local ASR.
FAIRY_WHISPER_CLI=
FAIRY_WHISPER_MODEL=
# Optional signed read-only Mac bridge. A development build can be created under
# apps/mac-bridge/FairyMacBridge; production use requires signing and TCC review.
FAIRY_MAC_BRIDGE_EXECUTABLE=
